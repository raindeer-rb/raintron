name: Build cross-platform executables

on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  RUBY_VERSION: "<%= ruby_version %>"

jobs:
  press:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: macos-latest
            name: macos
          # Not ubuntu-latest: Ubuntu 24.04 dropped the libwebkit2gtk-4.0-dev
          # package entirely (only 4.1 dev headers ship now), and webview_ruby's
          # own native extension Rakefile hardcodes a `pkg-config ... webkit2gtk-4.0`
          # query -- verified directly against a real failed CI run and the gem's
          # upstream source. 22.04 is still a supported LTS (through 2027) and still
          # has the 4.0 package, so pin to it until webview_ruby targets 4.1.
          - os: ubuntu-22.04
            name: linux
          - os: windows-latest
            name: windows
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      # webview_ruby's Windows build attempts to compile via ffi-compiler's generic
      # MinGW path, but fails -- confirmed via a real CI run, not assumed:
      # webview.h's Windows/Edge backend #includes winrt/Windows.Foundation.Collections.h,
      # a C++/WinRT header the MinGW toolchain RubyInstaller for Windows ships
      # doesn't provide (needs MSVC + the Windows SDK instead). Tebako's Windows
      # release leg is also still "in flight" upstream, independently.
      # Both remaining steps on this leg are best-effort so the workflow doesn't
      # block on a combination nobody currently ships, but starts passing on its
      # own the moment either upstream gap closes.

      - name: Install Linux build prerequisites
        if: matrix.name == 'linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential pkg-config libgtk-3-dev libwebkit2gtk-4.0-dev

      - name: Install Tebako
        if: matrix.name != 'windows'
        shell: bash
        run: |
          curl -fsSL https://tebako.org/install.sh -o /tmp/tebako_install.sh
          # Not `sh`: macOS's /bin/sh is an ancient bash (3.2) that mis-parses a
          # multibyte character in the installer's own output strings. dash (present
          # on macOS and Linux runners) doesn't have that bug; see install.sh's own
          # shebang note if this ever needs revisiting.
          dash /tmp/tebako_install.sh
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      - name: Install Tebako (Windows, best-effort)
        if: matrix.name == 'windows'
        shell: bash
        continue-on-error: true
        run: |
          curl -fsSL https://tebako.org/install.sh -o /tmp/tebako_install.sh
          bash /tmp/tebako_install.sh
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      - name: Press
        if: matrix.name != 'windows'
        shell: bash
        run: |
          mkdir -p dist
          tebako press -r . -e bin/desktop -o "dist/<%= app_name %>-${{ matrix.name }}" -R "$RUBY_VERSION" --format dwarfs

      - name: Press (Windows, best-effort)
        if: matrix.name == 'windows'
        shell: bash
        continue-on-error: true
        run: |
          mkdir -p dist
          tebako press -r . -e bin/desktop -o "dist/<%= app_name %>-windows.exe" -R "$RUBY_VERSION" --format dwarfs

      - name: Upload artifact
        if: matrix.name != 'windows'
        uses: actions/upload-artifact@v4
        with:
          name: <%= app_name %>-${{ matrix.name }}
          path: dist/<%= app_name %>-${{ matrix.name }}*
          if-no-files-found: error

      - name: Upload artifact (Windows, best-effort)
        if: matrix.name == 'windows'
        continue-on-error: true
        uses: actions/upload-artifact@v4
        with:
          name: <%= app_name %>-windows
          path: dist/<%= app_name %>-windows.exe
          if-no-files-found: ignore
